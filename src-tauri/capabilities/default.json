{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$TEMP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$TEMP/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
